MODULE wenglorDetect

    !***********************************************************
    !
    ! Module:  wenglorDetect
    !
    ! Author: wenglor sensoric GmbH
    !
    ! Version: 1.3.0
    !
    ! Description:
    !   This module handles object detection at wDetectionPose and movement to detected objects.
    !
    !***********************************************************

    FUNC robtarget detectTarget()
        VAR string cameraReply;

         cameraReply:=sendAndReadString("target:pose["+W_USE_CASE+","+W_CALIBRATION_TARGET+","+getRobPos()+"];");

         ! Format the object pose string from the camera response to fit the ABB pattern
        RETURN stringToPose(cameraReply);
    ENDFUNC

    ! Fills the camera-side buffer with object information and returns the first object pose.
    FUNC robtarget detectObjects()
        VAR string cameraReply;

        cameraReply:=sendAndReadString("detect["+W_USE_CASE+","+getRobPos()+"];");

        ! Format the object pose string from the camera response to fit the ABB pattern
        RETURN stringToPose(cameraReply);
    ENDFUNC

    ! After wDetectionPose, when the object information buffer is filled on the camera side, you can read the number of objects found, if linked in uniVision.
    LOCAL FUNC num readNumObjects()
        VAR string cameraReply;
        VAR bool numInside;
        VAR num numRead;

        cameraReply:=sendAndReadString("num_objects:get;");

        numInside:=StrToVal(cameraReply,numRead);
        IF (numInside) THEN
            RETURN numRead;
        ENDIF
    ENDFUNC

    ! After wDetectionPose, when the object information buffer is filled on the camera side, you can read the pose of an object, if linked in uniVision.
    LOCAL FUNC robtarget readPoseByIndex(num index)
        VAR string cameraReply;

        cameraReply:=sendAndReadString("pose:get["+ValToStr(index)+"];");
        ! Format the object pose string from the camera response to fit the ABB pattern
        RETURN stringToPose(cameraReply);
    ENDFUNC

    ! After wDetectionPose, when the object information buffer is filled on the camera side, you can read the shape model of an object, if linked in uniVision.
    LOCAL FUNC num readShapeByIndex(num index)
        VAR string cameraReply;
        VAR bool numInside;
        VAR num numRead;

        cameraReply:=sendAndReadString("shape:get["+ValToStr(index)+"];");

        numInside:=StrToVal(cameraReply,numRead);
        IF (numInside) THEN
            RETURN numRead;
        ENDIF
    ENDFUNC

    ! After wDetectionPose, when the object information buffer is filled on the camera side, you can read an additional value of an object, if linked in uniVision.
    LOCAL FUNC string readValueByIndex(num index)
        VAR string cameraReply;

        cameraReply:=sendAndReadString("value:get["+ValToStr(index)+"];");
        ! As the additional value is very use-case specific, no default checks can be done here.
        ! So custom checks have to be added.
        RETURN cameraReply;
    ENDFUNC

    PROC singleDetection()
        VAR robtarget objectPose;
        VAR string userValue;
        VAR num shape;

        ! update current tool
        GetSysData currentToolValue;

        IF (wDetectionPose=emptyPose) THEN
            warningMessage("Exit program as wDetectionPose pose is not set.");
            EXIT;
        ENDIF

        calibrateIfNeeded;

        loadJob(W_DETECT_OBJECTS_JOB);

        MoveL wDetectionPose,v200,fine,currentToolValue;

        objectPose:=detectObjects();
        shape:=readShapeByIndex(0);
        ! Link additional value in the uniVision job before using readValueByIndex.
        !userValue:=readValueByIndex(0);

        ! Here you can add conditional checks for shape or userValue

        MoveL objectPose,v100,fine,currentToolValue;
    ENDPROC

    PROC multiDetection()
        VAR num numObjects;
        VAR num shape;
        VAR string userValue;
        VAR robtarget objectPose;

        ! update current tool
        GetSysData currentToolValue;

        IF (wDetectionPose=emptyPose) THEN
            warningMessage("Exit program as wDetectionPose pose is not set.");
            EXIT;
        ENDIF

        calibrateIfNeeded;

        loadJob(W_DETECT_OBJECTS_JOB);

        MoveL wDetectionPose,v200,fine,currentToolValue;

        objectPose:=detectObjects();

        numObjects:=readNumObjects();

        FOR i FROM 0 TO numObjects-1 DO
            shape:=readShapeByIndex(i);
            ! Link additional value in the uniVision job before using readValueByIndex.
            !userValue:=readValueByIndex(i);
            objectPose:=readPoseByIndex(i);

            ! Here you can add conditional checks for shape or userValue

            MoveL objectPose,v100,fine,currentToolValue;
        ENDFOR
    ENDPROC

    PROC updateReferenceFrame()
        VAR robtarget targetPose;

        calibrateIfNeeded;
        loadJob(W_DETECT_TARGET_JOB);

        ! Move to the pose where the vision system can see the calibration target
        MoveL wDetectionPose,v200,fine,currentToolValue;

        targetPose:=detectTarget();

        ! Update the reference frame for all poses inside the machine
        wReferenceFrame.uframe.trans :=targetPose.trans;
        wReferenceFrame.uframe.rot := targetPose.rot;

        IF (W_MACHINE_POSES_TAUGHT = FALSE) THEN
            ! This handles the initial state for the first setup
            infoMessage("Reference frame updated. Please teach poses now relative to wReferenceFrame");
            infoMessage("Set W_MACHINE_POSES_TAUGHT to TRUE and restart after teaching the poses.");
            EXIT;
        ENDIF

        ! Now the machine reference frame is updated and with it also the poses inside the machine, so the machine poses can be approached now

        ! Maybe add support pose in between

        ! Move to poses in machine that were taught relative to the wReferenceFrame, wPoseInMachine is just a dummy pose
        MoveL wPoseInMachine,v200,fine,currentToolValue \WObj:=wReferenceFrame;
    ENDPROC

    PROC callUserCommand()
        ! Call the desired procedure depending on the user command in the config
        IF (W_USER_COMMAND="singleDetection") THEN
            singleDetection;
        ELSEIF (W_USER_COMMAND="multiDetection") THEN
            multiDetection;
        ELSEIF (W_USER_COMMAND="updateReferenceFrame") THEN
            updateReferenceFrame;
        ENDIF
    ENDPROC

    PROC main()
            callUserCommand;
    ENDPROC

ENDMODULE