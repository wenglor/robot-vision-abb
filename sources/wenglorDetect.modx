MODULE wenglorDetect

    !***********************************************************
    !
    ! Module:  wenglorDetect
    !
    ! Author: wenglor sensoric GmbH
    !
    ! Version: 1.1.0
    !
    ! Description:
    !   This is the module that manages the actual object wenglorDetection and movement to the objects.
    !
    !***********************************************************

    PROC main()
        VAR btnres answer;
        VAR robtarget objectPose;

        ! update current tool
        GetSysData currentToolValue;

        updateCameraState;

        ! Run calibration procedure if camera to robot is not already calibrated
        IF wenglorCalibDone=FALSE THEN
            runCalibration;
        ENDIF

        IF (wenglorDetection=emptyPose) THEN
            UIMsgBox\Header:=WENGLOR_MESSAGE_HEADER,"Exit program as wenglorDetection pose is not set."\Buttons:=btnOK,\Icon:=iconWarning;
            EXIT;
        ENDIF

        updateCameraState;

        ! calibration data required, so abort, when they are still not available
        IF (wenglorCalibDone=FALSE) THEN
            UIMsgBox\Header:=WENGLOR_MESSAGE_HEADER,"Exit program as calibration data is not available",\Buttons:=btnOK\Icon:=iconWarning;
            EXIT;
        ENDIF

        sendSimpleCommand("job:change["+WENGLOR_DETECTION_JOB+"];");

        MoveL wenglorDetection,v200,fine,currentToolValue;

        objectPose:=detectObjects();

        MoveL objectPose,v100,fine,currentToolValue;
    ENDPROC

    ! Fills the buffer on camera side with the object information and returns the first object object pose
    FUNC robtarget detectObjects()
        VAR string cameraReply;
        VAR string formattedMessage;
        VAR bool errorCodeInside;
        VAR num errorCode;
        VAR robtarget errorPose;

        cameraReply:=sendAndReadString("detect["+WENGLOR_USE_CASE+","+getRobPos()+"];");

        errorCodeInside:=StrToVal(cameraReply,errorCode);
        IF (errorCodeInside) THEN
            ! Return current pose in case of error, as no other pose can be considered safe
            setReturnError errorCode;
            errorPose:=CRobT();
            RETURN errorPose;
        ENDIF

        ! Format the object pose string from the camera response to fit the ABB pattern
        formattedMessage:=replaceParantheses(cameraReply);
        RETURN stringToPose(formattedMessage);
    ENDFUNC

    ! After the wenglorDetection, when the object infromation buffer is filled on camera side, you can read the pose of an object, linked in univison
    LOCAL FUNC robtarget readPoseIndex(num index)
        VAR string cameraReply;
        VAR string formattedMessage;
        VAR bool errorCodeInside;
        VAR num errorCode;
        VAR robtarget errorPose;

        cameraReply:=sendAndReadString("pose:get["+ValToStr(index)+"];");

        errorCodeInside:=StrToVal(cameraReply,errorCode);
        IF (errorCodeInside) THEN
            ! return current pose in case of error, as no other pose can be considered safe
            setReturnError errorCode;
            errorPose:=CRobT();
            RETURN errorPose;
        ENDIF

        formattedMessage:=replaceParantheses(cameraReply);
        RETURN stringToPose(formattedMessage);
    ENDFUNC

    ! After the wenglorDetection, when the object infromation buffer is filled on camera side, you can read the number of objects, that were found, if linked in univison
    LOCAL FUNC num readNumObjects()
        VAR string cameraReply;
        VAR bool numInside;
        VAR num numRead;

        cameraReply:=sendAndReadString("num_objects:get;");

        numInside:=StrToVal(cameraReply,numRead);
        IF (numInside) THEN
            IF (numRead<0) THEN
                setReturnError numRead;
                RETURN -1;
            ELSE
                RETURN numRead;
            ENDIF
        ENDIF
    ENDFUNC

    ! After the wenglorDetection, when the object infromation buffer is filled on camera side, you can read the shape model of an object, if linked in univison
    LOCAL FUNC num readShapeIndex(num index)
        VAR string cameraReply;
        VAR bool numInside;
        VAR num numRead;

        cameraReply:=sendAndReadString("shape:get["+ValToStr(index)+"];");

        numInside:=StrToVal(cameraReply,numRead);
        IF (numInside) THEN
            IF (numRead<0) THEN
                setReturnError numRead;
                RETURN -1;
            ELSE
                RETURN numRead;
            ENDIF
        ENDIF
    ENDFUNC

    ! After the wenglorDetection, when the object infromation buffer is filled on camera side, you can read the additional value of an object, if linked in univison
    LOCAL FUNC string readValueIndex(num index)
        VAR string cameraReply;

        cameraReply:=sendAndReadString("value:get["+ValToStr(index)+"];");
        ! As the additional value is very usecase specific, no default checks can be done here.
        ! So custom checks have to be added.
        RETURN cameraReply;
    ENDFUNC
ENDMODULE